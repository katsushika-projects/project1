# =======================
# 本番環境設定
# =======================

# Django本番モード
IS_DEBUG=False

# DjangoのSECRET_KEY（本番用に生成したもの）
DJANGO_SECRET_KEY=

# =======================
# Supabase DB設定
# =======================

DB_ENGINE=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# =======================
# 静的/メディアファイル（必要に応じて）
# =======================

STATIC_ROOT=/usr/share/nginx/html/static
MEDIA_ROOT=/usr/share/nginx/html/media

# =======================
# フロントエンドURL（CORS, CSRF用）
# =======================

# CLIENT_URL=https://uni-bo.net
# SITE_NAME=uni-bo.net

CLIENT_URL=http://localhost:3000
SITE_NAME=localhost:3000

# =======================
# Node（開発用）※必要なら残す
# =======================

NODE_PATH=./src
