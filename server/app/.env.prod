# 本番環境用のenvファイルのサンプル

# 開発環境ではTrue, 本番環境ではFalse
IS_DEBUG=False

# DjangoのSECRET_KEY
DJANGO_SECRET_KEY="本番環境用のシークレットキー" # 自分で記入

# データベースの設定
DB_ENGINE=django.db.backends.postgresql
DB_NAME= # 自分で記入
DB_USER= # 自分で記入
DB_PASSWORD= # 自分で記入
DB_HOST= # 自分で記入
DB_PORT= # 自分で記入

STATIC_ROOT=/usr/share/nginx/html/static

MEDIA_ROOT=/usr/share/nginx/html/media

# ReactのURL
CLIENT_URL=https://uni-bo.net
# ドメイン名
SITE_NAME=uni-bo.net

NODE_PATH=./src

EMAIL_BACKEND="anymail.backends.mailgun.EmailBackend"
DEFAULT_FROM_EMAIL="support@mg.uni-bo.net"
MAILGUN_API_KEY=""
MAILGUN_SENDER_DOMAIN="mg.uni-bo.net"
SERVER_EMAIL="l.00.kocha.00.l@gmail.com"  # サーバーエラーメールの送信先
