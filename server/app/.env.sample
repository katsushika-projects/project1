# 共通
SECRET_KEY="your-secret-key"
DEBUG=False  # ← 本番ではFalse、開発ではTrueに変更
LANGUAGE_CODE='ja'
TIME_ZONE='Asia/Tokyo'

# ReactのURL
CLIENT_URL=http://localhost:3000  # 本番では https://yourdomain.com に置き換え

NODE_PATH=./src

# Firebase認証を使う場合（例として追加）
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project-id.iam.gserviceaccount.com

# データベース（どちらか一方を使う）

# 開発用（例：ローカルPostgreSQL）
# DATABASE_URL=psql://youruser:yourpassword@localhost:5432/yourdbname

# 本番用（例：Supabase接続情報）
DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=db.xxx.supabase.co
DB_PORT=5432

# 静的ファイル・メディア（本番用）
STATIC_ROOT=/usr/share/nginx/html/static
MEDIA_ROOT=/usr/share/nginx/html/media
