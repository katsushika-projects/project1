# 開発環境（Docker）用のenvファイルのサンプル

# 開発環境ではTrue, 本番環境ではFalse
# IS_DEBUG= # 上位の.envファイルで設定

# DjangoのSECRET_KEY
# DJANGO_SECRET_KEY= # 上位の.envファイルで設定

# データベースの設定
# DB_ENGINE= # 上位の.envファイルで設定
# DB_NAME= # 上位の.envファイルで設定
# DB_USER= # 上位の.envファイルで設定
# DB_PASSWORD= # 上位の.envファイルで設定
# DB_HOST= # 上位の.envファイルで設定
# DB_PORT= # 上位の.envファイルで設定

# STATIC_ROOT= # 不要

# MEDIA_ROOT= # 不要

# ReactのURL
# CLIENT_URL= # 上位の.envファイルで設定
# ドメイン名
# SITE_NAME= # 不要

# NODE_PATH= # 不要
